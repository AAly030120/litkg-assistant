# ============================================================
# LitKG Assistant 环境变量配置
# 复制此文件为 .env 并填入真实值
# ============================================================

# -------------------- LLM API 配置 --------------------
# OpenAI 兼容 API 的 Base URL
# 示例：OpenAI 官方 → https://api.openai.com/v1
#        通义千问   → https://dashscope.aliyuncs.com/compatible-mode/v1
#        DeepSeek   → https://api.deepseek.com/v1
LLM_BASE_URL=https://api.openai.com/v1

# API Key
LLM_API_KEY=sk-your-api-key-here

# 模型名称
# 推荐：gpt-4o-mini（性价比高）、deepseek-chat、qwen-turbo-latest
LLM_MODEL_NAME=gpt-4o-mini

# -------------------- LLM 调用参数 --------------------
# 抽取时的 temperature（0~1，越低越确定）
LLM_EXTRACT_TEMPERATURE=0.1

# 问答时的 temperature
LLM_QA_TEMPERATURE=0.3

# 单次请求超时时间（秒）
LLM_TIMEOUT=120

# 最大重试次数
LLM_MAX_RETRIES=3

# 并发请求数上限（避免触发 rate limit）
LLM_MAX_CONCURRENCY=3

# -------------------- Embedding 模型（MVP-1 ChromaDB）--------------------
# OpenAI 兼容的 embedding 模型
# OpenAI: text-embedding-ada-002, text-embedding-3-small
# 通义千问: text-embedding-v1, text-embedding-v2
EMBEDDING_MODEL=text-embedding-ada-002

# embedding 维度
EMBEDDING_DIM=1536

# -------------------- 文件路径 --------------------
# 知识图谱 JSON 持久化路径
KG_JSON_PATH=data/kg.json

# 论文索引文件路径
PAPERS_INDEX_PATH=data/papers_index.json

# 上传 PDF 存储目录
PAPERS_DIR=data/papers

# Chunk 缓存目录
CHUNKS_DIR=data/chunks

# 向量数据库目录（MVP-1 ChromaDB）
VECTOR_DB_DIR=data/vector_db

# -------------------- PDF 解析参数 --------------------
# 每个 chunk 的最大字符数
CHUNK_SIZE=800

# chunk 之间的重叠字符数
CHUNK_OVERLAP=100

# 页眉过滤比例（页面顶部 0~15% 视为页眉区域）
HEADER_RATIO=0.12

# 页脚过滤比例（页面底部 85%~100% 视为页脚区域）
FOOTER_RATIO=0.88

# -------------------- 向量检索（MVP-1 ChromaDB）--------------------
# 向量检索返回 top-k 个 chunk
TOP_K_CHUNKS=3

# 是否启用混合检索（KG + 向量）
HYBRID_RETRIEVAL=true

# KG 检索跳数
KG_HOPS=2

# 向量检索权重（0~1，用于融合排序）
VECTOR_WEIGHT=0.5

# -------------------- 日志 --------------------
LOG_LEVEL=INFO
LOG_FILE=litkg.log

# -------------------- Neo4j 图数据库（MVP-2 可选）--------------------
# 如果不配置密码，系统将自动降级到 NetworkX + JSON 模式
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
