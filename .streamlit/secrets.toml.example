# ─────────────────────────────────────
# 本地开发用 secrets 模板
# 复制为本文件同目录下的 secrets.toml 并填入真实值
# secrets.toml 已在 .gitignore 中，不会被提交到 GitHub
#
# Streamlit Cloud 部署时在 Dashboard → Settings → Secrets 中配置
# ─────────────────────────────────────

LLM_API_KEY = "sk-your-api-key-here"
LLM_BASE_URL = "https://api.openai.com/v1"
LLM_MODEL_NAME = "gpt-4o-mini"
